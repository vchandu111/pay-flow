# Copy to .env and fill in real values. Never commit .env.
# Generate secrets with: openssl rand -hex 32

DATABASE_URL=postgresql://payflow:payflow@localhost:5432/payflow_dev
TEST_DATABASE_URL=postgresql://payflow:payflow@localhost:5432/payflow_test

PORT=4000
NODE_ENV=development

ACCESS_TOKEN_SECRET=replace-with-openssl-rand-hex-32
REFRESH_TOKEN_SECRET=replace-with-a-different-openssl-rand-hex-32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14

COOKIE_DOMAIN=localhost
CORS_ORIGIN=http://localhost:5180
