{
  "name": "payflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PayFlow — digital wallet and money-transfer platform (Phase 1: Foundation)",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "db:up": "bash scripts/setup-db.sh",
    "db:migrate": "npm run prisma:migrate --workspace backend",
    "db:seed": "npm run prisma:seed --workspace backend",
    "test": "jest --runInBand",
    "test:frontend": "npm run test --workspace frontend",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build": "npm run build --workspace backend && npm run build --workspace frontend"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jest": "30.5.2",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "ts-jest": "29.4.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "fsevents@2.3.3": true,
    "msw@2.15.0": true
  }
}
